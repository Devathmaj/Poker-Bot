[TEMPLATE]
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# PostgreSQL connection string used for chip wallets.
DATABASE_URL=postgresql://user:password@localhost:5432/pokerbot

# Optional: also register the slash commands in one server, so command
# updates show up instantly while developing. Commands always sync globally
# too, which is what lists them in the bot's profile.
# GUILD_ID=123456789012345678
