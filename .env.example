[TEMPLATE]
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# PostgreSQL connection string used for chip wallets.
# Required: both Docker Compose and `python -m pokerbot` read this.
# Use a hosted/cloud database (as in the default Compose setup) or a local one.
DATABASE_URL=postgresql://user:password@host:5432/pokerbot

# Optional: also register the slash commands in one server, so command
# updates show up instantly while developing. Commands always sync globally
# too, which is what lists them in the bot's profile.
# GUILD_ID=123456789012345678

# Optional: where the health endpoint that uptime pollers hit (GET /health)
# listens. A hosting platform that injects PORT overrides HEALTH_PORT; both
# fall back to 8080. The bind address defaults to 0.0.0.0 so the platform can
# reach the port.
# PORT=8080
# HEALTH_HOST=0.0.0.0
# HEALTH_PORT=8080

# Optional: only used when you enable the bundled PostgreSQL service in
# docker-compose.yml (it is commented out by default, since the bot uses the
# cloud DATABASE_URL above). Leave these unset for the defaults shown.
# POSTGRES_USER=pokerbot
# POSTGRES_PASSWORD=pokerbot
# POSTGRES_DB=pokerbot
